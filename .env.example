# DevSync AI Environment Variables

# Backend Port (default 5000)
PORT=5000

# Google Gemini API Key for AI features (Explain, Debug, Optimize, Context-Aware Chat)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String
# For Docker Compose: defaults to internal container 'mongodb://mongodb:27017/devsync'
# For local dev without Docker: 'mongodb://localhost:27017/devsync' or MongoDB Atlas URI
MONGODB_URI=mongodb://mongodb:27017/devsync

# Frontend Socket / API Endpoint (optional, defaults to origin or http://localhost:5000)
# VITE_SOCKET_URL=http://localhost:5000
